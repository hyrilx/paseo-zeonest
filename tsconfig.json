{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "react"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.client.tsx",
    "index.server.ts",
    "shell/**/*.ts",
    "shell/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/tests/**", "**/fixtures/**"]
}
