{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "react"
    ],
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "features/**/tests/**/*.ts",
    "features/**/tests/**/*.tsx",
    "tools/**/*.mjs"
  ],
  "exclude": ["node_modules", "**/fixtures/**"]
}
