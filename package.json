{
  "name": "paseo-zeonest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A statically composed container for personal Paseo extensions.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/bundle.js",
    "server/bundle.js",
    "client/bundle.d.ts",
    "server/bundle.d.ts",
    "tools/prepare.mjs"
  ],
  "scripts": {
    "typecheck": "node tools/typecheck.mjs",
    "build": "node tools/typecheck.mjs --runtime && node tools/build.mjs && node tools/check-bundles.mjs",
    "feature:new": "node tools/new-feature.mjs",
    "bundle:check": "node tools/check-bundles.mjs",
    "test": "node tools/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "node tools/prepare.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.3.1",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^11.0.8",
    "yaml": "^2.9.1"
  }
}
